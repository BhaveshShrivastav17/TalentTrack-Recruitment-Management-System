<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>All_Candidate_Access_for_Recruitment_Team</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Shares all candidate records with the Recruitment manager and internal subordinates roles.</description>
        <label>All Candidate Access for Recruitment Team</label>
        <sharedTo>
            <roleAndSubordinatesInternal>Recruitment_Manager</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>Last_Name__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>Recruitment_Team_Candidates_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Recruitment Team Candidates Access</label>
        <sharedTo>
            <roleAndSubordinatesInternal>Recruitment_Manager</roleAndSubordinatesInternal>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinatesInternal>Recruiter</roleAndSubordinatesInternal>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
